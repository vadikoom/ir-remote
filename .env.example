# Image and published UDP port. The controller currently sends to port 4944.
IMG_NAME=ir-remote
IR_LISTEN_PORT=4944

# image:run and tgbot:dev use DEV_BOT_API; SSH deployment uses BOT_API.
DEV_BOT_API=replace-with-development-telegram-token
BOT_API=replace-with-deployment-telegram-token
BOT_AUTHORIZED_USERS_V2='[{id: 123456789, name: "Your name"}]'

# Transmitter build configuration.
FIRMWARE_WIFI_SSID=replace-with-wifi-name
FIRMWARE_WIFI_PASS=replace-with-wifi-password
FIRMWARE_REMOTE_HOST=192.0.2.1
# Generate once with: openssl rand -hex 32
# Also used as IR_SHARED_SECRET by the bot tasks and SSH deployment.
FIRMWARE_SHARED_SECRET=replace-with-64-hexadecimal-characters

# Optional SSH deployment.
UPLOAD_VIA=user@host
REMOTE_DIR_NAME=ir-remote
